{
  "name": "@pangju/file-viewer",
  "private": false,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host --mode app --force",
    "build:lib": "vite build --mode lib",
    "build:app": "vite build --mode app",
    "preview": "vite preview --outDir dist/app",
    "type-check": "vue-tsc --noEmit",
    "prettier": "prettier --write ./**/*.{html,vue,js,ts,json,md}",
    "eslint": "eslint . --fix",
    "stylelint": "stylelint ./**/*.{css,less,vue,html} --fix",
    "prepare": "husky"
  },
  "files": [
    "dist/lib"
  ],
  "type": "module",
  "main": "./dist/lib/index.cjs.js",
  "module": "./dist/lib/index.es.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/index.es.js",
      "require": "./dist/lib/index.cjs.js"
    },
    "./index.css": "./dist/lib/file-viewer.css"
  },
  "peerDependencies": {
    "vue": "^3.5.29"
  },
  "dependencies": {
    "@babylonjs/viewer": "^8.54.1",
    "@onlyoffice/document-editor-vue": "^1.6.1",
    "@vicons/material": "^0.13.0",
    "dxf-viewer": "^1.0.46",
    "file-type": "^21.3.0",
    "md-editor-v3": "^6.4.0",
    "naive-ui": "^2.43.2",
    "nanoid": "^5.1.7",
    "three": "^0.161.0",
    "video.js": "^8.23.7",
    "viewerjs": "^1.11.7",
    "vue3-json-viewer": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/three": "0.161.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-less": "^4.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^5.0.3",
    "vue-tsc": "^3.2.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "pnpm run eslint",
      "pnpm run stylelint",
      "pnpm run prettier"
    ]
  }
}
