{
  "name": "file-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "prettier": "prettier --write ./**/*.{html,vue,js,ts,json,md}",
    "eslint": "eslint . --fix",
    "stylelint": "stylelint ./**/*.{css,less,vue,html} --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0",
    "@photo-sphere-viewer/core": "^5.14.0",
    "@photo-sphere-viewer/cubemap-adapter": "^5.14.0",
    "@vicons/material": "^0.13.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.5",
    "babylonjs": "^8.44.0",
    "babylonjs-loaders": "^8.44.0",
    "date-fns": "^4.1.0",
    "dxf-viewer": "^1.0.46",
    "es-toolkit": "^1.44.0",
    "file-type": "^21.2.0",
    "mavon-editor": "^3.0.2",
    "naive-ui": "^2.43.2",
    "three": "^0.179.0",
    "video.js": "^8.23.6",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.26",
    "vue-json-viewer": "^3.0.4",
    "vue-router": "^4.6.4",
    "vue3-audio-player": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-less": "^6.0.0",
    "prettier": "^3.7.4",
    "stylelint": "^17.3.0",
    "stylelint-config-recommended-less": "^4.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.2.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "pnpm run eslint",
      "pnpm run stylelint",
      "pnpm run prettier"
    ]
  }
}
