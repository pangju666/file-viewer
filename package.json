{
  "name": "@pangju/file-viewer",
  "private": false,
  "version": "1.0.0",
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "prettier": "prettier --write ./**/*.{html,vue,js,ts,json,md}",
    "eslint": "eslint . --fix",
    "stylelint": "stylelint ./**/*.{css,less,vue,html} --fix",
    "prepare": "husky"
  },
  "description": "基于 Vue3 和 Naive UI 的高集成度文件预览组件",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pangju666/file-viewer/issues"
  },
  "homepage": "https://github.com/pangju666/file-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pangju666/file-viewer.git"
  },
  "keywords": [
    "vue",
    "viewer",
    "preview",
    "file"
  ],
  "files": [
    "dist",
    "docs-images",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./index.css": "./dist/file-viewer.css"
  },
  "peerDependencies": {
    "vue": "^3.5.30"
  },
  "dependencies": {
    "@babylonjs/viewer": "^8.56.2",
    "@onlyoffice/document-editor-vue": "^1.6.1",
    "@vicons/ionicons5": "^0.13.0",
    "dxf-viewer": "^1.0.46",
    "file-type": "^21.3.4",
    "md-editor-v3": "^6.4.1",
    "naive-ui": "^2.44.1",
    "nanoid": "^5.1.7",
    "three": "^0.161.0",
    "video.js": "^8.23.7",
    "viewerjs": "^1.11.7",
    "vue3-json-viewer": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/three": "0.161.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-less": "^4.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "pnpm run eslint",
      "pnpm run stylelint",
      "pnpm run prettier"
    ]
  }
}
